import pandas as pd
import numpy as np
import tensorflow as tf
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.metrics import classification_report
import os

print("--- QYRA V2 TinyML Training Pipeline ---")
print("Loading synthetic hardware telemetry...")

# 1. load the dataset generated by our physics simulation script
try:
    df = pd.read_csv('qyra_synthetic_telemetry.csv')
except FileNotFoundError:
    print("Error: Please upload 'qyra_synthetic_telemetry.csv' to the Colab files area first.")
    exit()

# 2. separate features (sensor data) from targets (medical state)
X = df.drop('label', axis=1).values
y_text = df['label'].values

# 3. encode the text labels into integers (0 to 4) for the neural network
label_encoder = LabelEncoder()
y = label_encoder.fit_transform(y_text)
num_classes = len(label_encoder.classes_)

print(f"Class Mapping for ESP32 C++ Logic:")
for i, class_name in enumerate(label_encoder.classes_):
    print(f"  {i} -> {class_name}")

# 4. feature scaling (CRITICAL FOR EMBEDDED ML)
# gsr goes up to 4095, but accel is usually around 1.0. if we don't scale this, 
# the neural net will ignore the accelerometer and over-focus on sweat levels.
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)

# 5. build the tinyml architecture
# keeping it intentionally shallow (16 -> 8 neurons) so the esp32-s3 can run 
# inferences in <5ms without blocking the max30102 i2c reads.
model = tf.keras.Sequential([
    tf.keras.layers.Dense(16, activation='relu', input_shape=(X_train.shape[1],)),
    tf.keras.layers.Dense(8, activation='relu'),
    tf.keras.layers.Dense(num_classes, activation='softmax')
])

model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])

# 6. train the model
print("\nTraining neural network...")
model.fit(X_train, y_train, epochs=25, batch_size=32, validation_split=0.2, verbose=1)

# 7. evaluate performance
loss, accuracy = model.evaluate(X_test, y_test, verbose=0)
print(f"\n--- Final Test Accuracy: {accuracy * 100:.2f}% ---")

y_pred = np.argmax(model.predict(X_test, verbose=0), axis=-1)
print("\nClassification Report:")
print(classification_report(y_test, y_pred, target_names=label_encoder.classes_))

# 8. convert and quantize for microcontrollers
# we use 8-bit integer quantization to shrink the model footprint for the esp32 flash memory
print("Quantizing model to 8-bit for ESP32-S3 deployment...")
converter = tf.lite.TFLiteConverter.from_keras_model(model)
converter.optimizations = [tf.lite.Optimize.DEFAULT]
tflite_quantized_model = converter.convert()

# 9. pure python C++ header generation
# bypassing the linux 'xxd' command here because it sometimes fails in colab/windows 
# and spits out 0-byte files. this pure python approach is 100% reliable.
print("Generating C++ header file (qyra_model_data.h)...")
hex_array = ', '.join([f'0x{byte:02x}' for byte in tflite_quantized_model])

with open("qyra_model_data.h", "w") as f:
    f.write("// QYRA V2 TinyML Triage Model\n")
    f.write("// Auto-generated by QYRA_Training_Pipeline.py\n\n")
    f.write("#ifndef QYRA_MODEL_DATA_H\n")
    f.write("#define QYRA_MODEL_DATA_H\n\n")
    
    # alignas(8) is highly recommended for espressif tensor operations to prevent memory alignment panics
    f.write("alignas(8) const unsigned char qyra_triage_model_tflite[] = {\n")
    
    chunk_size = 120
    for i in range(0, len(hex_array), chunk_size):
        f.write("  " + hex_array[i:i+chunk_size] + "\n")
        
    f.write("};\n\n")
    f.write(f"const unsigned int qyra_triage_model_tflite_len = {len(tflite_quantized_model)};\n\n")
    f.write("#endif // QYRA_MODEL_DATA_H\n")

print(f"\nSuccess! 'qyra_model_data.h' is ready for download ({len(tflite_quantized_model)} bytes).")

# 10. export hardware scaling constants
mean_str = ", ".join([f"{x:.4f}" for x in scaler.mean_])
std_str = ", ".join([f"{x:.4f}" for x in scaler.scale_])

print("\n=======================================================")
print("PASTE THESE EXACT CONSTANTS INTO YOUR ESP32 MAIN.CPP:")
print("=======================================================")
print(f"const float FEATURE_MEANS[8] = {{{mean_str}}};")
print(f"const float FEATURE_STDDEVS[8] = {{{std_str}}};")
print("=======================================================")
